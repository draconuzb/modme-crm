# ═══════════════════════════════════════
# Modme CRM — Environment Variables
# Copy this file: cp .env.example .env
# Then fill in real values
# ═══════════════════════════════════════

# ── PostgreSQL ──
POSTGRES_DB=modme_crm
POSTGRES_USER=modme
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# ── Redis ──
REDIS_PASSWORD=CHANGE_ME_redis_password_here

# ── JWT Secrets (generate with: openssl rand -hex 32) ──
JWT_SECRET=CHANGE_ME_jwt_secret_here
JWT_REFRESH_SECRET=CHANGE_ME_jwt_refresh_secret_here

# ── App Settings ──
NODE_ENV=production
APP_PORT=80
CORS_ORIGIN=http://your-domain.com

# ── Database URL (auto-composed in docker-compose.prod.yml, needed for local dev) ──
DATABASE_URL=postgresql://modme:CHANGE_ME_strong_password_here@localhost:5432/modme_crm?schema=public
